const features = [
  {
    title: "Track what actually matters to you",
    description:
      "Peptides, supplements, off-label protocols, sauna, cold plunge — whatever you're doing, OwnPulse tracks it without judgment. No substance name validation. No one deciding what's 'real' health data.",
  },
  {
    title: "Reviewable by design",
    description:
      "The app is open source so you can inspect how your data is stored, exported, deleted, and synced. Hosted OwnPulse charges for operated infrastructure and storage, not lock-in.",
  },
  {
    title: "Your data stays portable",
    description:
      "Export your data, delete your account, or self-host on your own server. Community sharing is an opt-in roadmap item, not a default behavior.",
  },
];
---

<section class="py-6 md:py-10 bg-surface">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid md:grid-cols-3 gap-6">
      {features.map((feature) => (
        <div class="border border-neutral-200 rounded-lg bg-surface-elevated p-6">
          <h3 class="text-xl font-bold text-neutral-900 font-display">{feature.title}</h3>
          <p class="mt-3 text-neutral-600 leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
